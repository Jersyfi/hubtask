{
  "name": "@hubtask/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Hubtask to-do application in the browser. Embedded into the server binary (ADR-0028).",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "dev:mobile": "vite --mode mobile",
    "build": "vite build && node build/check-csp.js",
    "build:desktop": "vite build --mode desktop && node build/check-csp.js",
    "build:mobile": "vite build --mode mobile && node build/check-csp.js && node build/check-mobile-bundle.js",
    "preview": "vite preview",
    "preview:fixture": "node e2e/preview.mjs",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node ../../packages/design-system/build/lint-no-literals.js && node ../../packages/design-system/build/lint-direction.js && node ../../packages/design-system/build/lint-status.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test \"src/**/*.test.ts\" \"build/*.test.js\"",
    "test:engines": "node --test \"e2e/*.test.mjs\"",
    "desktop:icons": "tauri icon ../../packages/design-system/dist/mark/app-icon.svg --output src-tauri/icons && node build/check-shell-icons.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:openssl": "src-tauri/android-openssl.sh",
    "android:build": "tauri android build"
  },
  "dependencies": {
    "@hubtask/design-system": "workspace:*",
    "@hubtask/sync-engine": "workspace:*",
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "playwright": "1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
