{
  "name": "@hubtask/webapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Hubtask to-do application in the browser. Embedded into the server binary (ADR-0028).",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
