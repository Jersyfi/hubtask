{
  "name": "@hubtask/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Hubtask project website (hubtask.eu). Deployed as static files, never embedded.",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node build/check-static.js",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('.svelte-kit',{recursive:true,force:true})\"",
    "lint": "node ../../packages/design-system/build/lint-no-literals.js",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test build/*.test.js"
  },
  "dependencies": {
    "@hubtask/design-system": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
