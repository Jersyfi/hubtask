    {
      "type": "TASK",
      "capabilities": ["COMPLETION", "DUE_DATE", "REMINDER", "ASSIGNMENT", "MEMBERS", "BUCKET", "NOTES", "LABELS", "COMMENTS", "COVER", "ATTACHMENTS", "HISTORY", "RECURRENCE", "CUSTOM_FIELDS"],
