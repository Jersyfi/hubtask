      "capabilities": ["COMPLETION", "DUE_DATE", "REMINDER", "ASSIGNMENT", "MEMBERS", "NOTES", "LABELS", "COMMENTS", "ATTACHMENTS", "HISTORY", "CUSTOM_FIELDS"],
