{
  "name": "@hubtask/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hubtask design tokens and the CSS layer generated from them. One origin: tokens/tokens.json.",
  "license": "BUSL-1.1",
  "exports": {
    ".": "./dist/tokens.ts",
    "./components": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./tokens.json": "./tokens/tokens.json"
  },
  "files": [
    "dist",
    "src",
    "tokens"
  ],
  "scripts": {
    "build": "node build/build.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "node build/lint-no-literals.js",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test test/*.test.js",
    "workbench": "node build/build.js && vite --config workbench/vite.config.ts",
    "workbench:build": "node build/build.js && vite build --config workbench/vite.config.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "style-dictionary": "^5.5.2",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0"
  }
}
