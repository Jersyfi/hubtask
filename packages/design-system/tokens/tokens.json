  "motion": {
    "$description": "What a movement is for. design-system.md §9 asked for this layer by name: four easings and six durations existed and nothing said which was entrance, which was exit, which was emphasis and which carried a celebration slot - so five components animated an entrance and three of them disagreed about how long one lasts. A component names the role; the pair behind it is decided here, once. Rule 6 still applies on top: every one of these reduces to the colour change under reduced motion, and none of them animates anything but opacity and transform.",
    "state": {
      "$description": "A control acknowledging a change to itself - checked, switched, pressed, hovered. The reader is looking straight at it and is waiting for nothing, so it is the shortest role there is.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.fast}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.standard}"
      }
    },
    "attach": {
      "$description": "A layer arriving against an anchor the reader is already at: a tooltip, a menu, a popover. It is faster than an entrance because the pointer is already there - a delay here reads as lag rather than as arrival.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.fast}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.entrance}"
      }
    },
    "entrance": {
      "$description": "A surface arriving on its own, away from the pointer: a dialog, a toast, a drawer. Slower than an attach on purpose - it appears where the reader was not looking, and the movement is what carries their eye to it.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.base}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.entrance}"
      }
    },
    "exit": {
      "$description": "A surface leaving. Always shorter than its arrival: waiting for something that is already finished is the one delay a reader notices every time. No wave 1 component leaves with an animation - dismissal unmounts the node - so the first user is F2-05's Drawer, and this is declared ahead of it for the reason primitive.duration.celebrate is.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.fast}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.exit}"
      }
    },
    "emphasis": {
      "$description": "Drawing attention to something that is already on screen and has not moved: a row accepting a drop, a value that changed underneath the reader. The spring is what separates it from a state change. First user: F2-12.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.base}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.spring}"
      }
    },
    "celebration": {
      "$description": "§7's slot, and nothing else. The one role that may be longer than a fifth of a second, because it is the only movement whose purpose is to be enjoyed rather than understood. First user: F6's celebration kit.",
      "duration": {
        "$type": "duration",
        "$value": "{primitive.duration.celebrate}"
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": "{primitive.easing.spring}"
      }
    }
  },
  "density": {
    "$description": "How much air a control and a row carry. design-system.md §9: '§5 has a size prop and no density decision. A task tool with long lists needs one.' It is a property of the region rather than of the component - a list of two hundred rows does not want each row told individually - so it travels as data-density the way the theme travels as data-theme (ADR-0043), and size stays what it is: how prominent one control is next to another. Unlike the theme, this scale HAS a correct default and the stylesheet gives it one: a document that forgets data-density gets comfortable and looks right, because extra air is not a defect the way the wrong colour scheme is. The floor is not a taste: no min in either mode is below 24px, which is WCAG 2.2 SC 2.5.8's minimum target size. A denser step would be a conformance failure rather than a preference.",
    "comfortable": {
      "$description": "The default, and what wave 1 was built at. Nothing here is a change: the steps are the ones the eight controls already wrote, moved to where a second component cannot disagree with them.",
      "control": {
        "md": {
          "block": {
            "$type": "dimension",
            "$value": "{primitive.space.100}"
          },
          "min": {
            "$type": "dimension",
            "$value": "{primitive.space.500}"
          }
        },
        "sm": {
          "block": {
            "$type": "dimension",
            "$value": "{primitive.space.050}"
          },
          "min": {
            "$type": "dimension",
            "$value": "{primitive.space.400}"
          }
        }
      },
      "row": {
        "block": {
          "$type": "dimension",
          "$value": "{primitive.space.150}"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{primitive.space.150}"
        }
      }
    },
    "compact": {
      "$description": "One step tighter, for a screen that is mostly rows. Every control drops to the next step down and sm lands on 24px, which is the floor named above and not a value that may be tuned further.",
      "control": {
        "md": {
          "block": {
            "$type": "dimension",
            "$value": "{primitive.space.050}"
          },
          "min": {
