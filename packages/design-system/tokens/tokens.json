    "borderWidth": {
      "$description": "Border widths. A hairline round a control is the one measurement wave 1 needs that the radius and space scales do not carry, and `lint-no-literals` catches it at the first Checkbox - which is what makes this a scale rather than a preference. Three steps and no more: `hairline` draws a boundary, `thick` draws one that has to be seen at a glance, and `ring` is rule 5's focus ring and nothing else.",
      "hairline": {
        "$type": "dimension",
        "$value": "1px",
        "$description": "The boundary of a control, and the divider between two of them."
      },
      "thick": {
        "$type": "dimension",
        "$value": "1.5px",
        "$description": "A boundary that carries state: a checked box, a selected card."
      },
      "ring": {
        "$type": "dimension",
        "$value": "2px",
        "$description": "Rule 5's focus ring, at rule 5's offset. Never a border."
      }
    },
    "layer": {
      "$description": "The layering scale. Every element that leaves the flow takes its z-index from here and never from a number written at the call site - five overlays each picking their own is the failure design-system.md avoids by having this scale at all. The steps are ten apart so that a component may sit one above its own layer without borrowing the next one's rank.",
      "base": {
        "$type": "number",
        "$value": 0,
        "$description": "The document flow. Nothing is raised."
      },
      "raised": {
        "$type": "number",
        "$value": 10,
        "$description": "Lifted within the flow: a card under the pointer, a row being dragged."
      },
      "sticky": {
        "$type": "number",
        "$value": 100,
        "$description": "Stays put while the page scrolls under it: the app bar, a table header."
      },
      "overlay": {
        "$type": "number",
        "$value": 200,
        "$description": "The scrim, and what is anchored to the viewport edge behind a dialog: a drawer."
      },
      "dialog": {
        "$type": "number",
        "$value": 300,
        "$description": "A modal that owns the focus until it is dismissed."
      },
      "popover": {
        "$type": "number",
        "$value": 400,
        "$description": "Anchored to a trigger and dismissed by it: Menu, Popover, a Select list. Above a dialog, because one opens inside one."
      },
      "tooltip": {
        "$type": "number",
