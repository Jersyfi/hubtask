    {
      "family": "IBM Plex Sans",
      "rename": "IBM Plex Sans Variable",
      "package": "@fontsource-variable/ibm-plex-sans",
      "stylesheets": ["wght.css", "wght-italic.css"],
      "output": "fonts.css",
      "notice": "ibm-plex",
      "scripts": { "Latn": "Hubtask", "Cyrl": "Задачи", "Grek": "Εργασίες" }
    },
    {
