    "reply_templates": {
      "acknowledge": {
        "name": "We have your request",
        "body": "Hello {{requester.name}},\n\nthank you - we have your request “{{entry.title}}” ({{entry.id}}) and are working on it.\n\n{{agent.name}}"
      },
      "more_information": {
        "name": "We need more information",
        "body": "Hello {{requester.name}},\n\nto go on with “{{entry.title}}” we need a little more from you. Could you tell us more?\n\n{{agent.name}}"
      },
      "resolved": {
        "name": "Resolved",
        "body": "Hello {{requester.name}},\n\nwe have resolved “{{entry.title}}”. If something is still wrong, just answer this message.\n\n{{agent.name}}"
      }
    }
