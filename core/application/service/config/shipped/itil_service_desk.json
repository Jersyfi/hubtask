{
  "key": "itil_service_desk",
  "version": 1,
  "document": {
    "modules": {
      "workflows": {
        "switch": "ON"
      },
      "service_desk": {
        "switch": "ON"
      }
    },
    "roles": {
      "cab_member": {
        "name": "CAB member",
        "permissions": [
          "READ",
          "COMMENT"
        ]
      }
    },
    "fields": {
      "impact": {
        "kind": "SELECT",
        "options": [
          "High",
          "Medium",
          "Low"
        ],
        "applies_to": [
          "TASK"
        ]
      },
      "urgency": {
        "kind": "SELECT",
        "options": [
          "High",
          "Medium",
          "Low"
        ],
        "applies_to": [
          "TASK"
        ]
      },
      "priority": {
        "kind": "SELECT",
        "options": [
          "P1",
          "P2",
          "P3",
          "P4"
        ],
        "applies_to": [
          "TASK"
        ]
      }
    },
    "types": {
