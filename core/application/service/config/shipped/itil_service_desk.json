    "workflows": {
      "incident": {
        "name": "Incident",
        "shape": {
          "initial": "new",
          "statuses": [
            {
              "key": "new",
              "name": "New",
              "category": "TODO",
              "color_token": "slate"
            },
            {
              "key": "in_progress",
              "name": "In progress",
              "category": "IN_PROGRESS",
              "color_token": "blue"
            },
            {
              "key": "waiting",
              "name": "Waiting",
              "category": "IN_PROGRESS",
              "color_token": "amber"
            },
            {
              "key": "resolved",
              "name": "Resolved",
              "category": "DONE",
              "color_token": "green"
            },
            {
              "key": "closed",
              "name": "Closed",
              "category": "DONE",
              "color_token": "slate"
            }
          ],
          "steps": [
            {
              "key": "start",
              "name": "Start",
              "from": [
                "new"
              ],
              "to": "in_progress"
            },
            {
              "key": "wait",
              "name": "Wait for requester",
              "from": [
                "in_progress"
              ],
              "to": "waiting"
            },
            {
              "key": "resume",
              "name": "Resume",
              "from": [
                "waiting"
              ],
              "to": "in_progress"
            },
            {
              "key": "resolve",
              "name": "Resolve",
              "from": [
                "new",
                "in_progress",
                "waiting"
              ],
              "to": "resolved"
            },
            {
              "key": "close",
              "name": "Close",
              "from": [
                "resolved"
              ],
              "to": "closed"
            },
            {
              "key": "reopen",
              "name": "Reopen",
              "from": [
                "resolved"
              ],
              "to": "in_progress"
            }
          ]
        }
      },
      "service_request": {
        "name": "Service request",
        "shape": {
          "initial": "new",
          "statuses": [
            {
              "key": "new",
              "name": "New",
              "category": "TODO",
              "color_token": "slate"
            },
            {
              "key": "in_progress",
              "name": "In progress",
              "category": "IN_PROGRESS",
              "color_token": "blue"
            },
            {
              "key": "waiting",
              "name": "Waiting",
              "category": "IN_PROGRESS",
              "color_token": "amber"
            },
            {
              "key": "fulfilled",
              "name": "Fulfilled",
              "category": "DONE",
              "color_token": "green"
            }
          ],
          "steps": [
            {
              "key": "start",
              "name": "Start",
              "from": [
                "new"
              ],
              "to": "in_progress"
            },
            {
              "key": "wait",
              "name": "Wait for requester",
              "from": [
                "in_progress"
              ],
              "to": "waiting"
            },
            {
              "key": "resume",
              "name": "Resume",
              "from": [
                "waiting"
              ],
              "to": "in_progress"
            },
            {
              "key": "fulfil",
              "name": "Fulfil",
              "from": [
                "new",
                "in_progress",
                "waiting"
              ],
              "to": "fulfilled"
            }
          ]
        }
      },
      "problem": {
        "name": "Problem",
        "shape": {
          "initial": "new",
          "statuses": [
            {
              "key": "new",
              "name": "New",
              "category": "TODO",
              "color_token": "slate"
            },
            {
              "key": "investigating",
              "name": "Investigating",
              "category": "IN_PROGRESS",
              "color_token": "blue"
            },
            {
              "key": "known_error",
              "name": "Known error",
              "category": "IN_PROGRESS",
              "color_token": "amber"
            },
            {
              "key": "resolved",
              "name": "Resolved",
              "category": "DONE",
              "color_token": "green"
            }
          ],
          "steps": [
            {
              "key": "investigate",
              "name": "Investigate",
              "from": [
                "new"
              ],
              "to": "investigating"
            },
            {
              "key": "record_known_error",
              "name": "Record known error",
              "from": [
                "investigating"
              ],
              "to": "known_error"
            },
            {
              "key": "resolve",
              "name": "Resolve",
              "from": [
                "investigating",
                "known_error"
              ],
              "to": "resolved"
            }
          ]
        }
      },
      "change": {
        "name": "Change",
        "shape": {
          "initial": "draft",
          "statuses": [
            {
              "key": "draft",
              "name": "Draft",
              "category": "BACKLOG",
              "color_token": "slate"
            },
            {
              "key": "assessment",
              "name": "Assessment",
              "category": "TODO",
              "color_token": "blue"
            },
            {
              "key": "approved",
              "name": "Approved",
              "category": "IN_PROGRESS",
              "color_token": "teal"
            },
            {
              "key": "implementing",
              "name": "Implementing",
              "category": "IN_PROGRESS",
              "color_token": "blue"
            },
            {
              "key": "done",
              "name": "Done",
              "category": "DONE",
              "color_token": "green"
            },
            {
              "key": "declined",
              "name": "Declined",
              "category": "DONE",
              "color_token": "red"
            }
          ],
          "steps": [
            {
              "key": "submit",
              "name": "Submit for assessment",
              "from": [
                "draft"
              ],
              "to": "assessment"
            },
            {
              "key": "approve",
              "name": "Approve",
              "from": [
                "assessment"
              ],
              "to": "approved",
              "approval": {
                "levels": [
                  {
                    "roles": [
                      "cab_member"
                    ],
                    "rule": "ANY"
                  }
                ],
                "decline_to": "declined",
                "due_hours": 72
              }
            },
            {
              "key": "implement",
              "name": "Implement",
              "from": [
                "approved"
              ],
              "to": "implementing"
            },
            {
              "key": "complete",
              "name": "Complete",
              "from": [
                "implementing"
              ],
              "to": "done"
            }
          ]
        }
      }
