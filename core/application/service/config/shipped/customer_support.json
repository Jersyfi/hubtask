{
  "key": "customer_support",
  "version": 3,
  "document": {
    "modules": {
      "workflows": {
        "switch": "ON"
      },
      "service_desk": {
        "switch": "ON"
      }
    },
    "fields": {
      "support_category": {
        "name": "Category",
        "kind": "SELECT",
        "applies_to": [
          "TASK"
        ],
        "options": [
          "Question",
          "Problem",
          "Complaint",
          "Feature wish"
        ]
      },
      "support_priority": {
        "name": "Priority",
        "kind": "SELECT",
        "applies_to": [
          "TASK"
        ],
        "options": [
          "High",
          "Normal",
          "Low"
        ]
      },
      "support_customer": {
        "name": "Customer",
        "kind": "TEXT",
        "applies_to": [
          "TASK"
        ]
      }
    },
    "types": {
      "support_case": {
        "level": "TASK",
        "name": "Support case",
        "icon": "inbox",
        "color_token": "violet",
        "workflow": true,
        "form": {
          "sections": [
            {
              "key": "request",
              "name": "Request"
            },
            {
              "key": "handling",
              "name": "Handling"
            }
          ],
          "fields": [
            {
              "key": "title",
              "section": "request",
              "required": true
            },
            {
              "key": "notes",
              "section": "request"
            },
            {
              "key": "custom_fields.support_category",
              "section": "request"
            },
            {
              "key": "custom_fields.support_customer",
              "section": "request"
            },
            {
              "key": "custom_fields.support_priority",
              "section": "handling"
            }
          ],
          "channels": [
            {
              "channel": "PORTAL"
            }
          ]
        }
      }
    },
    "workflows": {
      "support_case": {
        "name": "Support case",
        "shape": {
          "initial": "new",
          "statuses": [
            {
              "key": "new",
              "name": "New",
              "category": "TODO",
              "color_token": "slate"
            },
            {
              "key": "in_progress",
              "name": "In progress",
              "category": "IN_PROGRESS",
              "color_token": "blue"
            },
            {
              "key": "waiting",
              "name": "Waiting",
              "category": "IN_PROGRESS",
              "color_token": "amber"
            },
            {
              "key": "resolved",
              "name": "Resolved",
              "category": "DONE",
              "color_token": "green"
            }
          ],
          "steps": [
            {
              "key": "start",
              "name": "Start",
              "from": [
                "new"
              ],
              "to": "in_progress"
            },
            {
              "key": "wait",
              "name": "Wait for requester",
              "from": [
                "in_progress"
              ],
              "to": "waiting"
            },
            {
              "key": "resume",
              "name": "Resume",
              "from": [
                "waiting"
              ],
              "to": "in_progress"
            },
            {
              "key": "resolve",
              "name": "Resolve",
              "from": [
                "new",
                "in_progress",
                "waiting"
              ],
              "to": "resolved"
            },
            {
              "key": "reopen",
              "name": "Reopen",
              "from": [
                "resolved"
              ],
              "to": "in_progress"
            }
          ]
        }
      }
    }
  },
  "hub": {
    "modules": {
      "workflows": {
        "switch": "ON"
      },
      "service_desk": {
        "switch": "ON"
      }
    },
    "scheme": {
      "support_case": {
        "workflow": "support_case"
      }
    },
    "structure": {
      "entry_types": {
        "value": {
          "TASK": [
            "support_case"
          ]
        }
      }
    }
  }
}
