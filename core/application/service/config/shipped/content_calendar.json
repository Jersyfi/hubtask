        "applies_to": [
          "TASK"
        ]
      },
      "content_owner": {
        "name": "Owner",
        "kind": "USER",
        "applies_to": [
          "TASK"
        ]
      },
      "content_link": {
        "name": "Link",
        "kind": "URL",
        "applies_to": [
          "TASK"
        ]
      }
    },
    "types": {
      "content_piece": {
        "level": "TASK",
        "name": "Content",
        "icon": "file-text",
        "color_token": "violet",
