# Copy to .env and fill in. No default values for secrets (fail closed).

# Required
POSTGRES_PASSWORD=
# The password of the application role (hubtask_app). The migrator grants the login; the
# application connects with it, so that row level security applies to what it does.
# URL-safe characters only - it travels inside a connection URL: openssl rand -hex 24
HUBTASK_DB_APP_PASSWORD=
# openssl rand -base64 32
HUBTASK_SECRET_KEY=

# Optional

# Envelope encryption (E-02). The keyring is the master keys this installation holds, current
# first; leave it empty and the installation encrypts nothing and says so when asked to.
# Rotating is adding a new identifier at the front and keeping the old one: nothing is rewritten,
# and values sealed under the old key stay readable until you remove it.
#   HUBTASK_ENCRYPTION_KEYS=k2026,k2025
#   HUBTASK_ENCRYPTION_KEY_K2026=$(openssl rand -base64 32)
#   HUBTASK_ENCRYPTION_KEY_K2025=...
HUBTASK_PORT=8080
# The operations port is bound to loopback: metrics, /readyz and /meta/health.
HUBTASK_OPS_PORT=9090
HUBTASK_BASE_URL=http://localhost:8080
HUBTASK_VERSION=latest
POSTGRES_DB=hubtask
POSTGRES_USER=hubtask

# Reminders by mail (without SMTP, /meta/health reports a warning)
# HUBTASK_SMTP_HOST=
# HUBTASK_SMTP_PORT=587
# HUBTASK_SMTP_USER=
# HUBTASK_SMTP_PASSWORD=
# HUBTASK_SMTP_FROM=hubtask@example.org
# HUBTASK_SMTP_SECURITY=starttls

# Object storage instead of a local volume
# HUBTASK_STORAGE_KIND=s3
# HUBTASK_S3_ENDPOINT=
# HUBTASK_S3_BUCKET=
# HUBTASK_S3_ACCESS_KEY=
# HUBTASK_S3_SECRET_KEY=

# AI is off by default (ADR-0012, ADR-0018)
# HUBTASK_AI_ENABLED=true
# HUBTASK_AI_PROVIDER=ollama
# HUBTASK_AI_ENDPOINT=http://ollama:11434
