# Copy to .env and fill in. No default values for secrets (fail closed).

# Required
POSTGRES_PASSWORD=
# The password of the application role (hubtask_app). The migrator grants the login; the
# application connects with it, so that row level security applies to what it does.
# URL-safe characters only - it travels inside a connection URL: openssl rand -hex 24
HUBTASK_DB_APP_PASSWORD=
# openssl rand -base64 32
HUBTASK_SECRET_KEY=
# The address people reach this installation at: every link in a mail, an invitation and a
# sign-in redirect is built on it. Compose refuses to start without it. On your own machine only:
# http://localhost:8080 - anywhere else localhost is a dead link for everybody you invite, and
# /meta/health warns (config.base_url_loopback).
HUBTASK_BASE_URL=

# Optional

# Backup targets (E-03). A `local` target writes inside the `backups` volume, which compose.yaml
# mounts at /var/lib/hubtask/backups and names as HUBTASK_BACKUP_LOCAL_PATH itself; a target's own
# path is relative to it and cannot leave it.
# A target on the same private network - a MinIO, a NAS - is refused until the egress guard is
# released for the installation. That is a decision made once here rather than per target.
#   HUBTASK_HTTP_ALLOW_PRIVATE_NETWORKS=true

# Envelope encryption (E-02). The keyring is the master keys this installation holds, current
# first; leave it empty and the installation encrypts nothing and says so when asked to - and a
# backup to an encrypted target fails in the worker rather than at the request.
#
# `compose.yaml` passes `k1` through by name. Rotating is adding a new identifier at the front,
# keeping the old one - nothing is rewritten, and values sealed under the old key stay readable
# until you remove it - and it needs one more line in `compose.yaml`, because Compose cannot pass
# a variable whose name comes from another variable.
#   HUBTASK_ENCRYPTION_KEYS=k1
#   HUBTASK_ENCRYPTION_KEY_K1=$(openssl rand -base64 32)
HUBTASK_PORT=8080
# The operations port is bound to loopback: metrics, /readyz and /meta/health.
HUBTASK_OPS_PORT=9090
# The release this installation runs, as its image tag (vX.Y.Z). Required: Compose refuses to start
# without it, because a floating tag would upgrade across migrations on the next pull, with no
# backup and no record of the version to go back to. The copy attached to a release carries it.
HUBTASK_VERSION=
# Before a release this database has not run yet migrates it, the stack dumps the database into
# the upgrade-dumps volume and keeps the last few; a failed dump stops the upgrade. Switch it off
# only when the database is backed up otherwise.
# HUBTASK_UPGRADE_DUMP=true
# HUBTASK_UPGRADE_DUMPS_KEPT=3
POSTGRES_DB=hubtask
POSTGRES_USER=hubtask

# The installation's operators, as workspace:address, comma-separated - added to the operator
# register at start and as the accounts come to exist; removing an entry removes nobody. The first
# start's setup in the browser makes its owner an operator anyway, so this is for an installation
# brought up without a person at a browser.
# HUBTASK_OPERATORS=acme:ada@acme.example

# Reminders by mail (without SMTP, /meta/health reports a warning)
# HUBTASK_SMTP_HOST=
# HUBTASK_SMTP_PORT=587
# HUBTASK_SMTP_USER=
# HUBTASK_SMTP_PASSWORD=
# HUBTASK_SMTP_FROM=hubtask@example.org
# HUBTASK_SMTP_SECURITY=starttls

# Mail into the jumble, collections and entries, without a mail server of your own (ADR-0092).
# Point the domain's MX at an inbound service (Postmark, Mailgun, SES, Cloudflare Email Routing)
# and have it POST each raw message to https://<your host>/api/v1/mail/inbound with the key as
# "Authorization: Bearer <key>" or as the password of basic credentials in the URL. Every place then
# shows its address, <name>.<code>@<domain>.
# HUBTASK_MAIL_INBOUND_DOMAIN=in.example.org
# HUBTASK_MAIL_INBOUND_KEY=

# Voice assistants (ADR-0093): an operator that publishes one Alexa skill for every workspace names
# it here, comma-separated. Without it, each workspace connects a skill of its own.
# HUBTASK_ALEXA_SKILL_IDS=amzn1.ask.skill.…

# Connected mailboxes through the provider's sign-in (ADR-0094): an OAuth app the installation
# registered at Google or Microsoft makes "Connect with Google/Microsoft" one button for every
# workspace. Register <HUBTASK_BASE_URL>/administration/mail/oauth as the redirect URI, and
# <HUBTASK_BASE_URL>/profile/calendars for a person's calendar feed written into their calendar
# (allow graph.microsoft.com and www.googleapis.com for it), and <HUBTASK_BASE_URL>/profile/files
# for Microsoft's OneDrive and SharePoint picked from on an entry. In multi-tenant operation these
# three stay on HUBTASK_BASE_URL: the page there forwards the return to the workspace's own host,
# where the connection is finished. Without
# them, a workspace administrator enters an app of their own - for these or any other provider.
# Allow the token and IMAP hosts in the egress allowlist (oauth2.googleapis.com, imap.gmail.com,
# login.microsoftonline.com, outlook.office365.com; graph.microsoft.com for a Microsoft 365 mailbox
# read through Graph, which the same Microsoft app grants with Mail.ReadWrite).
# HUBTASK_MAIL_OAUTH_GOOGLE_CLIENT_ID=
# HUBTASK_MAIL_OAUTH_GOOGLE_CLIENT_SECRET=
# HUBTASK_MAIL_OAUTH_MICROSOFT_CLIENT_ID=
# HUBTASK_MAIL_OAUTH_MICROSOFT_CLIENT_SECRET=

# The migrator's bound on one run, 30m by default. An upgrade over a large database may need longer;
# a run cut off is resumed by the next `docker compose up` where it stopped.
# HUBTASK_MIGRATE_TIMEOUT=30m

# Object storage instead of a local volume
# HUBTASK_STORAGE_KIND=s3
# HUBTASK_S3_ENDPOINT=
# HUBTASK_S3_BUCKET=
# HUBTASK_S3_ACCESS_KEY=
# HUBTASK_S3_SECRET_KEY=

# Scanning uploads with a ClamAV daemon (host:port or unix:/path); overrides the instance file's
# upload_scanner, and with both empty nothing is scanned. Under an egress allowlist the daemon's
# host must be on it. A file the
# daemon cannot answer for is held - attachable, never downloaded - and scanned again until it does.
# HUBTASK_CLAMD_ADDRESS=clamav:3310
# HUBTASK_CLAMD_TIMEOUT=2m
# The daemon's StreamMaxLength (clamd's default 25 MiB): with a scanner, uploads are capped to it,
# and a held file over it is settled as too large to scan, never served.
# HUBTASK_CLAMD_STREAM_MAX_BYTES=26214400

# AI is off by default (ADR-0012, ADR-0018), and it is not switched on here: the provider, its
# address, its models and its key are a workspace's, set with `hubctl ai config-set`
# (ai-first.md §2). What the installation itself decides:
#
# Whether AI processing may leave the EEA - the operator's confirmation, never a workspace's
# (data-protection.md §6).
# HUBTASK_AI_ALLOW_THIRD_COUNTRY_TRANSFER=false
# How alike two entries have to be before one is proposed as the other's duplicate (K-04). Empty
# takes the built-in default of 0.85, measured in docs/archive/evidence/K-04-2026-09-11.md: lower
# fills an inbox with entries that merely share a subject, higher proposes little but copies,
# silently.
# HUBTASK_AI_DUPLICATE_THRESHOLD=0.85

# Where a restore drill's last success is recorded, as a Unix timestamp in a file - by default in
# the restore-drill volume. Nothing writes it here: two containers have no operator doing
# continuous archiving, so it is the person who restored a dump and checked it who copies the
# number in (backup-restore.md §8.6). Until then the gauge A-20 watches stays absent - which is the
# honest state for backups nobody has restored. A path no volume mounts is warned at start (A-14).
# HUBTASK_RESTORE_DRILL_RECORD_FILE=/var/lib/hubtask/restore-drill/last_success_unix

# The installation's own settings file (deployment.md §6.1, ADR-0070): the installation's business
# calendars, the upload scanner, presets and plans live only there. A JSON file: put it beside
# compose.yaml, uncomment the instance.json line under the app's volumes there, and set the path
# inside the container; `seed` writes it once, `enforce` at every start.
# HUBTASK_INSTANCE_FILE=/etc/hubtask/instance.json
# HUBTASK_INSTANCE_FILE_MODE=seed

# Frames (security.md §9). Origins that may show the interface in a frame (a portal), and https
# origins a page's embed may show (a dashboard, a video); empty frames nothing and draws every
# embed as a link card.
# HUBTASK_UI_FRAME_ANCESTORS=https://portal.example.org
# HUBTASK_UI_FRAME_SOURCES=https://www.youtube-nocookie.com
# false answers / with 404 and leaves the API alone.
# HUBTASK_UI_ENABLED=true
# Browser origins outside the interface's own that may call the API.
# HUBTASK_CORS_ALLOWED_ORIGINS=

# The egress allowlist: hosts outbound calls may reach, comma-separated; empty is every public
# address.
# HUBTASK_HTTP_ALLOWED_HOSTS=
# Further roots outbound calls trust beside the system's, a PEM file inside the container (a
# private CA); empty adds none.
# HUBTASK_HTTP_CA_FILE=

# The installation's language and time zone for a person who has set none.
# HUBTASK_DEFAULT_LOCALE=en
# HUBTASK_DEFAULT_TIMEZONE=UTC

# Limits: an upload, an inbound mail, and the deadline every request inherits.
# HUBTASK_MAX_UPLOAD_BYTES=67108864
# HUBTASK_MAX_MAIL_BYTES=26214400
# HUBTASK_REQUEST_TIMEOUT=30s

# An optional message bus (ADR-0042); empty is off.
# HUBTASK_NATS_URL=
# HUBTASK_NATS_SUBJECT_PREFIX=hubtask

# Traces to an OTLP endpoint (observability-reliability.md §3.3).
# HUBTASK_TRACING_ENABLED=false
# HUBTASK_TRACING_ENDPOINT=
# HUBTASK_TRACING_SAMPLE_RATIO=0.05
