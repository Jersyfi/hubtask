{
  "uid": "hubtask-slo",
  "title": "Hubtask \u2014 Service level objectives",
  "description": "The eight objectives of observability-reliability.md \u00a72, one row each: the attainment over the objective's own window, and the signal underneath it. Shipped as an example - an operator imports it, points it at their Prometheus and edits freely; nothing in the application reads this file. SLO-1's burn panel reads the recorded series the provider alert file defines, so the dashboard and the page cannot disagree about what is burning.",
  "tags": [
    "hubtask"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "SLO-1 \u2014 API availability \u00b7 \u2265 99.9% of requests, 30 days rolling",
      "description": "The share of requests answered without a 5xx. SLO-1's 'without a timeout' half has no series of its own: a request the client abandoned appears as whatever status the middleware finally wrote (\u00a72).",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Attainment (30 d)",
      "description": "1 minus the 5xx share over the objective's own window. Below 99.9% the month is already lost; the budget panel beside it says by how much.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (\n  sum(increase(hubtask_http_requests_total{status_class=\"5xx\"}[30d]))\n  / clamp_min(sum(increase(hubtask_http_requests_total[30d])), 1)\n)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error budget left (30 d)",
      "description": "The budget is 0.1% of the month's requests. 50% consumed is the point where stability work takes precedence over features (\u00a72) - that is the amber step. Below zero the budget is overspent and the number says by how far.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "1 - (\n  sum(increase(hubtask_http_requests_total{status_class=\"5xx\"}[30d]))\n  / clamp_min(0.001 * sum(increase(hubtask_http_requests_total[30d])), 1)\n)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Burn rate, on the windows the alerts read",
      "description": "The recorded series the burn alerts evaluate, divided by the budget - so the y axis reads directly as a multiple. A-01 pages when the 1 h line passes 14 and the 5 m line agrees; A-02 when the 6 h line passes 6 and the 30 m line agrees. Two lines above a threshold with the other two below is an outage that has ended.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hubtask:slo1_error_ratio:rate5m / 0.001",
          "legendFormat": "5 m (A-01's confirmation)",
          "refId": "A"
        },
        {
          "expr": "hubtask:slo1_error_ratio:rate1h / 0.001",
          "legendFormat": "1 h (A-01 pages above 14)",
          "refId": "B"
        },
        {
          "expr": "hubtask:slo1_error_ratio:rate30m / 0.001",
          "legendFormat": "30 m (A-02's confirmation)",
          "refId": "C"
        },
        {
          "expr": "hubtask:slo1_error_ratio:rate6h / 0.001",
          "legendFormat": "6 h (A-02 pages above 6)",
          "refId": "D"
        }
      ]
    },
    {
      "type": "row",
      "title": "SLO-2 \u2014 Read latency \u00b7 P95 < 200 ms, 30 days",
      "description": "Reads are the GET routes plus the :query operations, which are POSTs because a filter does not fit in a URL (api-guidelines.md). The route label carries the method, so one selector names both.",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "P95 (30 d)",
      "description": "The objective as it is written. Read from the histogram over the whole window; the panel beside it answers the same question from the bucket boundary instead, without interpolation.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.2
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (\n  rate(hubtask_http_request_duration_seconds_bucket{route=~\"GET .*|.*:query\"}[30d])\n))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Within 200 ms (30 d)",
      "description": "The share of reads inside the target, counted from the 0.2 s bucket. P95 < 200 ms and this number \u2265 95% are the same statement, and this one needs no interpolation - which is why the boundary exists (\u00a74).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(hubtask_http_request_duration_seconds_bucket{route=~\"GET .*|.*:query\",le=\"0.2\"}[30d]))\n/ clamp_min(sum(increase(hubtask_http_request_duration_seconds_count{route=~\"GET .*|.*:query\"}[30d])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Read latency by route",
      "description": "Which route moved. A P95 that rises across every route is the database or the pool (A-11); one route alone is that route's query.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (\n  rate(hubtask_http_request_duration_seconds_bucket{route=~\"GET .*|.*:query\"}[30m])\n))",
          "legendFormat": "p95 {{route}}",
          "refId": "A"
        }
      ]
    },
