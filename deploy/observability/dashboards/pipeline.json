{
  "uid": "hubtask-pipeline",
  "title": "Hubtask \u2014 Pipeline",
  "description": "The work that happens outside a request: the outbox, the job queue and the scheduler (ADR-0007, ADR-0008). Reminders joined it with D-03, automation and webhooks with H-12 - the two rows \u00a711 has been promising since those features were metrics on paper.",
  "tags": [
    "hubtask"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Outbox lag P99",
      "description": "SLO-4: under 30 s. Alert A-05 pages above 60 s.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(hubtask_outbox_lag_seconds_bucket[10m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Queue depth",
      "description": "Due and waiting, across every kind. Rising monotonically is alert A-06.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(hubtask_job_queue_depth)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Dead letters (24 h)",
      "description": "Work the system finally gave up on. Every one needs a person (alert A-07).",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(hubtask_job_dead_letter_total[24h]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Scheduler tick lag",
      "description": "How late the leader's last tick was. A rising value means the schedule is drifting.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max(hubtask_scheduler_tick_lag_seconds)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outbox lag distribution",
      "description": "The age of an event when it reached its consumers.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(hubtask_outbox_lag_seconds_bucket[10m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hubtask_outbox_lag_seconds_bucket[10m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth, by kind",
      "description": "Reported by the scheduler leader only, so this is the installation's backlog - not one process's.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hubtask_job_queue_depth",
          "legendFormat": "{{job_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job duration, by kind",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(hubtask_job_duration_seconds_bucket[10m])))",
          "legendFormat": "p95 {{job_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job failures",
      "description": "attempt_class=retry is the system working - it will try again. attempt_class=final is the one that needs somebody.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (job_type, attempt_class) (rate(hubtask_job_failures_total[10m]))",
          "legendFormat": "{{job_type}} {{attempt_class}}",
          "refId": "A"
        },
        {
          "expr": "sum by (job_type) (rate(hubtask_job_dead_letter_total[10m]))",
          "legendFormat": "dead letter {{job_type}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reminder delay (SLO-5)",
      "description": "How late a reminder was against the moment it promised. SLO-5 asks for 99% within 60 s; alert A-08 raises a ticket when the P95 passes 120 s. A schedule that is on time with a mail server that is down shows up in the notification panels, not here.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(hubtask_reminder_delivery_delay_seconds_bucket[30m])))",
          "legendFormat": "p95 {{channel}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hubtask_reminder_delivery_delay_seconds_bucket[30m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Reminders fired",
      "description": "Reminders that became notifications, by channel. A flat line where reminders exist is the shape A-08 eventually alerts on: nothing is firing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (channel) (rate(hubtask_reminder_delivery_delay_seconds_count[10m]))",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rule runs, by outcome",
      "description": "SLO-7's raw material. Only ended runs are counted - a WAITING run is counted when it ends - and only `failed` is our fault: skipped, throttled and aborted_loop are a rule working exactly as it is configured.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(hubtask_rule_runs_total[10m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rules that switched themselves off",
      "description": "The self-protection made visible (A-16): consecutive failures, or the loop bound. Each step is somebody's automation that has stopped running until they re-enable it, and the owner has already been told.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(hubtask_rule_disabled_total[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook attempts, by outcome",
      "description": "One line per settled attempt (A-09, SLO-6). The 4xx class is the recipient's own refusal and is excluded from the objective - a subscriber answering 400 is a subscriber with a bug, not an outage here.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(hubtask_webhook_deliveries_total[10m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status_class) (rate(hubtask_webhook_deliveries_total{result!=\"ok\"}[10m]))",
          "legendFormat": "failed {{status_class}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Webhook retries waiting",
      "description": "One waiting attempt is one scheduled job. A backlog that grows while the ok line holds is a single target failing its way up the ladder; one that grows with ok falling is egress.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(hubtask_webhook_retry_backlog)",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "sum(increase(hubtask_webhook_deliveries_total{result=\"dead\"}[1h]))",
          "legendFormat": "dead-lettered / h",
          "refId": "B"
        }
      ]
    }
  ]
}
